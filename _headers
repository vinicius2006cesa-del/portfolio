# =====================================================================
# Cabeceras HTTP — Cloudflare Pages lee este archivo solo.
# No hay que configurar nada en el panel ni ejecutar ningun comando:
# se aplica en el deploy, igual que el resto del sitio.
#
# Para comprobar que estan activas despues de publicar:
#   curl -I https://viniciuscesa.com/
# =====================================================================

/*
  # Evita que otro sitio meta el tuyo dentro de un <iframe> invisible
  # para enganar a la gente a hacer clic (clickjacking).
  X-Frame-Options: DENY

  # El navegador respeta el tipo de archivo que declara el servidor y no
  # intenta "adivinarlo". Sin esto, un .txt podria ejecutarse como script.
  X-Content-Type-Options: nosniff

  # Cuando alguien sale de tu sitio, el otro sitio ve que viniste de
  # viniciuscesa.com pero no de que pagina exacta.
  Referrer-Policy: strict-origin-when-cross-origin

  # Apaga permisos del navegador que este sitio no usa. Si alguna vez te
  # inyectaran codigo, no podria pedir la camara ni la ubicacion.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

  # Obliga a los navegadores a entrar siempre por HTTPS durante un ano.
  # Sin "includeSubDomains" a proposito: los subdominios del mail son
  # otra cosa y no conviene atarlos a esta regla.
  Strict-Transport-Security: max-age=31536000

  # Lista blanca de lo unico que el navegador tiene permitido cargar o
  # contactar. Si manana alguien lograra inyectar un script en la pagina,
  # el navegador se niega a ejecutarlo porque no esta en esta lista.
  #
  # Los dominios cloudflareinsights.com son de Web Analytics: Cloudflare
  # Pages inyecta ese script solo, no esta en el codigo. Sin permitirlo
  # quedan bloqueadas las estadisticas de visitas.
  #   static.cloudflareinsights.com  -> de donde baja el script
  #   cloudflareinsights.com         -> a donde manda la medicion
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# =====================================================================
# Cuanto tiempo guarda el navegador cada archivo.
#
# OJO con "immutable": significa "este archivo NO va a cambiar nunca, ni
# te molestes en revisar". Solo sirve si el NOMBRE del archivo cambia
# cuando cambia el contenido (styles.a3f9.css y asi). Como aca los
# nombres son fijos, usar immutable dejaria a los visitantes con la
# version vieja hasta que venza el plazo, sin forma de forzar nada.
# Por eso no se usa en ningun lado de este archivo.
# =====================================================================

# El CSS y el JS son los que mas cambian, y cuando quedan viejos el
# sitio se ve roto (el navbar blanco con el logo invisible, por ejemplo).
# max-age=0 no significa "no guardar": el navegador igual se lo queda,
# pero pregunta siempre si hay algo nuevo. Si no cambio, el servidor
# responde "304 sin cambios" y no se descarga nada. Es casi gratis.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Las imagenes de los proyectos y la de compartir se van a reemplazar
# cuando tengas las capturas reales. Una hora alcanza para que ayude
# sin dejarte esperando.
/assets/img/*
  Cache-Control: public, max-age=3600

# Los archivos de marca cambian muy de vez en cuando: una semana.
/assets/marca/*
  Cache-Control: public, max-age=604800
